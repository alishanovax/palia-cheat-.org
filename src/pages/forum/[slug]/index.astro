---
import ForumPostPage from '../../../components/ForumPostPage.astro';
import { blogPosts, getPostBySlug, resolvePost } from '../../../data/forum/helpers';
import { defaultLocale } from '../../../data/i18n/locales';

export function getStaticPaths() {
	return blogPosts.map((post) => {
		const resolved = resolvePost(post, defaultLocale);
		return {
			params: { slug: resolved.translation.slug },
			props: { post: resolved },
		};
	});
}

const { post } = Astro.props;
const live = getPostBySlug(defaultLocale, post.translation.slug) ?? post;
---

<ForumPostPage locale="en" post={live} />
