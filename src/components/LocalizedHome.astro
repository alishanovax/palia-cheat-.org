---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HomeShowcase from '../components/HomeShowcase.astro';
import ProductDeals from '../components/ProductDeals.astro';
import HomeReviews from '../components/HomeReviews.astro';
import HomePurchaseOptions from '../components/HomePurchaseOptions.astro';
import HomeForums from '../components/HomeForums.astro';
import HomeSeo from '../components/HomeSeo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocaleContent, getPageContent } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { getForumBasePath } from '../data/forum/helpers';
import { isLocaleIndexed } from '../data/i18n/locale-indexing';
import type { LocaleCode } from '../data/i18n/locales';
import { homeSeo, siteConfig } from '../data/site';
import { heroPreloadSrc, heroSizes, heroSrcSet } from '../lib/responsive-images';
import { getPageCrawlImage } from '../data/page-images';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const { ui } = getLocaleContent(locale);
const home = getPageContent(locale, 'home');
const enHome = homeSeo();

const pageIndexed = isLocaleIndexed(locale);
/** Use clean EN hub meta until locale home copy is translated. */
const title = pageIndexed ? (locale === 'en' ? enHome.title : home.title) : enHome.title;
const description = pageIndexed ? (locale === 'en' ? enHome.description : home.description) : enHome.description;
const canonicalPath = getLocalizedPath('home', locale);

const homeLinks = {
	cheats: getLocalizedPath('features', locale),
	esp: getLocalizedPath('features', locale),
	aimbot: getLocalizedPath('features', locale),
	updates: getLocalizedPath('updates', locale),
	features: getLocalizedPath('features', locale),
	pricing: getLocalizedPath('pricing', locale),
	faq: getLocalizedPath('faq', locale),
	support: getLocalizedPath('support', locale),
	setup: getLocalizedPath('features', locale),
	teleport: getLocalizedPath('radar', locale),
	wallhack: getLocalizedPath('features', locale),
	forum: getForumBasePath(locale),
	refunds: getLocalizedPath('refund', locale),
};
const homeCrawl = getPageCrawlImage('home');
---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={homeCrawl.caption}
	locale={locale}
	pageId="home"
	breadcrumbs={[{ label: ui.nav.home }]}
	noindex={!pageIndexed}
	robotsFollow={!pageIndexed}
	lcpImage={heroPreloadSrc}
	lcpImageSrcSet={heroSrcSet}
	lcpImageSizes={heroSizes}
>
	<Navbar locale={locale} pageId="home" />
	<main class="home">
		<Hero locale={locale} />
		<HomeShowcase locale={locale} />
		<ProductDeals locale={locale} />
		<HomeForums locale={locale} cheatsHref={homeLinks.cheats} />
		<div class="home__seo">
			<HomeSeo locale={locale} links={homeLinks} />
		</div>
		<HomeReviews locale={locale} />
		<HomePurchaseOptions
			locale={locale}
			storeHref={homeLinks.pricing}
			featuresHref={homeLinks.features}
			cheatsHref={homeLinks.cheats}
		/>
		<SiteFooter locale={locale} />
	</main>
</Layout>

<style>
	.home {
		width: 100%;
		overflow-x: clip;
	}

	.home__seo {
		border-top: 1px solid var(--line-soft);
		background: var(--bg-panel);
		content-visibility: auto;
		contain-intrinsic-size: 1px 900px;
	}

</style>
