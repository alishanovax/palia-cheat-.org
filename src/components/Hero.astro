---
import HeroApp from './react/Hero';
import type { LocaleCode } from '../data/i18n/locales';
import { defaultLocale } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import { getLocalizedPath } from '../data/i18n/routing';
import { heroWidth, heroHeight, heroSrcSet, heroSizes, heroSrc } from '../lib/responsive-images';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];
const t = getT(locale);

const heroCopy = {
	title: t('hero.title'),
	subtitle: t('hero.subtitle'),
	ctaCheats: t('hero.viewCheats'),
	plansCta: t('hero.viewPlans'),
	imageAlt: t('hero.imageAlt', { brand: siteConfig.name }),
	trustPillsAria: t('trustPills.aria'),
	chips: {
		chipEsp: t('hero.chipEsp'),
		chipAim: t('hero.chipAim'),
		chipRadar: t('hero.chipRadar'),
		chipUpdates: t('hero.chipUpdates'),
	},
	trustPills: {
		fastUpdates: t('trustPills.fastUpdates'),
		secureCheckout: t('trustPills.secureCheckout'),
		easySetup: t('trustPills.easySetup'),
		premiumSupport: t('trustPills.premiumSupport'),
		instantDelivery: t('trustPills.instantDelivery'),
		eacMaintenance: t('trustPills.eacMaintenance'),
	},
};
---

<HeroApp
	client:load
	locale={locale}
	siteName={siteConfig.name}
	cheatsHref={getLocalizedPath('hacks', locale)}
	storeHref={getLocalizedPath('pricing', locale)}
	monthlyPrice={monthly.price}
	heroSrc={heroSrc}
	heroSrcSet={heroSrcSet}
	heroSizes={heroSizes}
	heroWidth={heroWidth}
	heroHeight={heroHeight}
	useBrandHero={true}
	copy={heroCopy}
/>

<style is:global>
	.hero {
		--hero-pad-y: clamp(1rem, 2vw, 1.75rem);
		--hero-stack: clamp(0.5rem, 1.1vw, 0.75rem);
		/*
		 * Wide hero bar — gameplay art crops with object-fit: cover (no squash).
		 */
		--hero-ratio: 3.15 / 1;
		position: relative;
		isolation: isolate;
		display: grid;
		align-items: center;
		overflow: hidden;
		background: #0d0a14;
		aspect-ratio: var(--hero-ratio);
		width: 100%;
		height: auto;
		min-height: 0;
		max-height: none;
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__media picture,
	.hero__media img {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero__media img {
		object-fit: cover;
		/* Character on the right; headline on the left */
		object-position: 62% center;
		image-rendering: auto;
		transform: translateZ(0);
		animation: hero-in 0.9s ease-out both;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: linear-gradient(
			90deg,
			rgba(13, 10, 20, 0.88) 0%,
			rgba(13, 10, 20, 0.62) 38%,
			rgba(13, 10, 20, 0.22) 62%,
			transparent 78%
		);
	}

	.hero__content {
		position: relative;
		z-index: 2;
		padding-block: var(--hero-pad-y);
		align-self: center;
		/* Sit a touch above true center so title reads mid-image */
		transform: translateY(clamp(-1.5rem, -3vw, -0.35rem));
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: start;
		box-sizing: border-box;
	}

	.hero__copy {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: var(--hero-stack);
		width: min(100%, 28rem);
		max-width: 100%;
		min-width: 0;
		margin: 0;
		padding: 0;
		animation: rise 0.65s ease-out both;
	}

	.hero__brand {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(2.1rem, 4.4vw, 3.25rem);
		font-weight: 700;
		line-height: 1.12;
		letter-spacing: -0.03em;
		overflow-wrap: anywhere;
		color: #fff;
		width: 100%;
		text-transform: uppercase;
	}

	.hero__lede {
		margin: 0;
		width: 100%;
		max-width: none;
		font-size: clamp(0.95rem, 1.5vw, 1.05rem);
		line-height: 1.5;
		color: color-mix(in srgb, #fff 74%, var(--ink-muted));
	}

	.hero__ghost {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-height: 2.75rem;
		padding: 0 1.15rem;
		border: 1px solid color-mix(in srgb, var(--magenta) 45%, var(--line));
		border-radius: var(--radius-pill);
		background: color-mix(in srgb, var(--magenta) 12%, transparent);
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
		box-shadow: 0 0 24px color-mix(in srgb, var(--magenta) 18%, transparent);
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			transform 0.2s ease;
	}

	.hero__ghost:hover {
		border-color: var(--magenta-soft);
		background: color-mix(in srgb, var(--magenta) 20%, transparent);
		transform: translateY(-2px);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.7rem;
		margin: 0;
		width: 100%;
	}

	.hero__buy {
		display: inline-flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.55rem;
		width: auto;
		max-width: 100%;
		min-height: 3rem;
		padding: 0.55rem 0.55rem 0.55rem 1.05rem;
		border-radius: 999px;
		background: #fff;
		color: #09090b;
		font-size: 0.9375rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 70%, transparent) inset,
			0 10px 28px rgba(0, 0, 0, 0.28);
		transition:
			transform 0.18s ease,
			background 0.18s ease,
			box-shadow 0.18s ease;
	}

	.hero__buy svg {
		width: 1.05rem;
		height: 1.05rem;
		flex-shrink: 0;
		opacity: 0.85;
	}

	.hero__buy-label {
		padding-right: 0.15rem;
	}

	.hero__buy-price {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		margin-left: auto;
		padding: 0 0.85rem;
		border-radius: 999px;
		background: #09090b;
		color: #fff;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.hero__buy:hover {
		background: #f4f4f5;
		color: #09090b;
		transform: translateY(-2px);
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 70%, transparent) inset,
			0 14px 32px rgba(0, 0, 0, 0.34);
	}

	.hero__buy:hover .hero__buy-price {
		background: var(--magenta);
	}

	.hero__buy:active {
		transform: translateY(0);
	}

	.hero__features {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 1rem;
		row-gap: 0.55rem;
		margin: 0;
		padding: 0;
		list-style: none;
		width: 100%;
		max-width: none;
	}

	.hero__features li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.3;
		color: color-mix(in srgb, #fff 72%, transparent);
	}

	.hero__features li span {
		min-width: 0;
	}

	.hero__features svg {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
		color: var(--magenta-soft);
	}

	.hero__pills {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 3;
		padding-block: 0.55rem 0.7rem;
		pointer-events: none;
	}

	.hero__pills-track {
		padding-inline: var(--page-gutter);
	}

	.hero__pills-list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.hero__pills-item {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.8rem;
		border: 1px solid color-mix(in srgb, #fff 14%, var(--magenta) 20%);
		border-radius: var(--radius-pill);
		background: color-mix(in srgb, rgba(13, 10, 20, 0.78) 88%, var(--magenta) 10%);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		font-size: 0.72rem;
		font-weight: 600;
		color: color-mix(in srgb, #fff 92%, var(--ink-muted));
		white-space: nowrap;
		pointer-events: auto;
		box-shadow: 0 4px 18px rgba(0, 0, 0, 0.28);
	}

	.hero__pills-dot {
		width: 0.38rem;
		height: 0.38rem;
		border-radius: 999px;
		background: var(--magenta-soft);
		box-shadow: 0 0 8px color-mix(in srgb, var(--magenta-soft) 55%, transparent);
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes hero-in {
		from {
			opacity: 0.7;
		}
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__copy,
		.hero__media img {
			animation: none;
		}

		.hero__buy,
		.hero__buy:hover {
			transition: none;
			transform: none;
		}

		.hero__content {
			transform: translateY(clamp(-1.5rem, -3vw, -0.35rem));
		}
	}

	/*
	 * Phones / small tablets: stop using the ultra-wide 3.15:1 bar.
	 * That ratio collapses to ~120px tall on a 390px phone and clips the CTA.
	 * Mobile = taller full-bleed panel; height grows with copy.
	 */
	@media (max-width: 900px) {
		.hero {
			aspect-ratio: auto;
			min-height: 0;
			max-height: none;
			height: auto;
			display: block;
			overflow: hidden;
		}

		.hero__media img {
			object-fit: cover;
			object-position: center 30%;
		}

		.hero__veil {
			background: linear-gradient(
				180deg,
				rgba(5, 5, 6, 0.28) 0%,
				rgba(5, 5, 6, 0.52) 42%,
				rgba(5, 5, 6, 0.9) 78%,
				rgba(5, 5, 6, 0.96) 100%
			);
		}

		.hero__content {
			transform: none;
			width: 100%;
			min-height: clamp(18.5rem, 56svh, 28rem);
			display: flex;
			align-items: flex-end;
			padding-block: 1.35rem 3.75rem;
			padding-bottom: max(3.75rem, calc(3.25rem + env(safe-area-inset-bottom, 0px)));
			box-sizing: border-box;
		}

		.hero__pills {
			padding-bottom: max(0.65rem, env(safe-area-inset-bottom, 0px));
		}

		.hero__pills-list {
			flex-wrap: nowrap;
			justify-content: flex-start;
			overflow-x: auto;
			scrollbar-width: none;
			-webkit-overflow-scrolling: touch;
			padding-block: 0.15rem;
		}

		.hero__pills-list::-webkit-scrollbar {
			display: none;
		}

		.hero__copy {
			width: 100%;
			max-width: 28rem;
			gap: 0.65rem;
		}

		.hero__brand {
			font-size: clamp(1.7rem, 7.5vw, 2.35rem);
			line-height: 1.08;
		}

		.hero__lede {
			display: block;
			overflow: visible;
			-webkit-line-clamp: unset;
			font-size: clamp(0.9rem, 3.6vw, 1rem);
			max-width: 34ch;
			color: color-mix(in srgb, #fff 80%, var(--ink-muted));
		}

		.hero__actions {
			width: 100%;
		}

		.hero__buy {
			width: 100%;
			max-width: 22rem;
			min-height: var(--touch-min, 2.75rem);
			font-size: 0.9375rem;
			justify-content: flex-start;
		}

		.hero__buy-price {
			margin-left: auto;
		}

		.hero__features {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 0.75rem;
			row-gap: 0.45rem;
			max-width: 22rem;
		}

		.hero__features li {
			font-size: 0.78rem;
		}
	}

	@media (max-width: 480px) {
		.hero__content {
			min-height: clamp(17.5rem, 60svh, 26rem);
			padding-block: 1.2rem 1.1rem;
		}

		.hero__brand {
			font-size: clamp(1.55rem, 8.2vw, 1.95rem);
		}

		.hero__lede {
			max-width: none;
		}

		.hero__buy {
			width: 100%;
			max-width: none;
		}

		.hero__features {
			max-width: none;
		}
	}

	@media (max-width: 360px) {
		.hero__content {
			min-height: clamp(16.5rem, 64svh, 24rem);
		}

		.hero__brand {
			font-size: 1.45rem;
		}

		.hero__features {
			grid-template-columns: 1fr;
			row-gap: 0.35rem;
		}
	}

	@media (max-width: 900px) and (orientation: landscape) and (max-height: 480px) {
		.hero__content {
			min-height: min(70svh, 16.5rem);
			padding-block: 0.85rem 0.8rem;
		}

		.hero__lede {
			display: -webkit-box;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
			overflow: hidden;
			font-size: 0.85rem;
		}

		.hero__features {
			display: none;
		}

		.hero__buy {
			max-width: 20rem;
		}
	}
</style>
