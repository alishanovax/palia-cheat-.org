---
interface Props {
	category: string;
	title: string;
	copy: string;
	href: string;
	readLabel: string;
}

const { category, title, copy, href, readLabel } = Astro.props;

const cat = category.toLowerCase();
const icon =
	cat.includes('setup')
		? 'setup'
		: cat.includes('comparison')
			? 'comparison'
			: cat.includes('buyers') || cat.includes('buyer')
				? 'guide'
				: 'features';

const categoryLabel =
	icon === 'setup'
		? 'Setup'
		: icon === 'comparison'
			? 'Comparison'
			: icon === 'guide'
				? 'Guide'
				: 'Features';
---

<article class="forum-card">
	<a class="forum-card__link" href={href}>
		<div class="forum-card__cat">
			<span class="forum-card__icon" aria-hidden="true">
				{
					icon === 'setup' ? (
						<svg viewBox="0 0 24 24" fill="none">
							<path
								d="M12 3.5l7.5 4.2v8.6L12 20.5l-7.5-4.2V7.7L12 3.5z"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linejoin="round"
							/>
							<path
								d="M9.5 11.5h5M9.5 14.5h3.5"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
							/>
						</svg>
					) : icon === 'comparison' ? (
						<svg viewBox="0 0 24 24" fill="none">
							<path
								d="M5.5 7.5h5.5v9H5.5v-9zM13 7.5h5.5v9H13v-9z"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linejoin="round"
							/>
							<path
								d="M9.25 11h5.5M9.25 13.5h5.5"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
							/>
						</svg>
					) : icon === 'guide' ? (
						<svg viewBox="0 0 24 24" fill="none">
							<rect
								x="5.5"
								y="4.5"
								width="13"
								height="15"
								rx="1.5"
								stroke="currentColor"
								stroke-width="1.5"
							/>
							<path
								d="M8.5 9h7M8.5 12h7M8.5 15h4.5"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
							/>
						</svg>
					) : (
						<svg viewBox="0 0 24 24" fill="none">
							<path
								d="M4.5 7.5h15M4.5 12h15M4.5 16.5h9"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
							/>
							<circle cx="17.5" cy="16.5" r="1.2" fill="currentColor" />
						</svg>
					)
				}
			</span>
			<span class="forum-card__label">{categoryLabel}</span>
		</div>
		<h3 class="forum-card__title">{title}</h3>
		<p class="forum-card__copy">{copy}</p>
		<span class="forum-card__read">
			{readLabel}
			<span aria-hidden="true">→</span>
		</span>
	</a>
</article>

<style>
	.forum-card {
		min-width: 0;
	}

	.forum-card__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 13.5rem;
		padding: 1.35rem 1.4rem 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--bg-elevated) 88%, var(--bg-panel));
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.forum-card__link:hover,
	.forum-card__link:focus-visible {
		border-color: color-mix(in srgb, var(--magenta) 55%, var(--line));
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--magenta) 35%, transparent),
			0 12px 32px color-mix(in srgb, var(--magenta) 12%, transparent);
		transform: translateY(-2px);
	}

	.forum-card__cat {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 0.85rem;
	}

	.forum-card__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.15rem;
		height: 1.15rem;
		color: var(--ink-faint);
	}

	.forum-card__icon svg {
		width: 100%;
		height: 100%;
	}

	.forum-card__label {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.11em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.forum-card__title {
		margin: 0;
		font-size: clamp(1.02rem, 1.5vw, 1.12rem);
		font-weight: 700;
		line-height: 1.35;
		color: var(--ink);
	}

	.forum-card__copy {
		margin: 0.65rem 0 0;
		flex: 1;
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--ink-muted);
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 4;
		overflow: hidden;
	}

	.forum-card__read {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 1.15rem;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--magenta-soft);
	}

	.forum-card__link:hover .forum-card__read,
	.forum-card__link:focus-visible .forum-card__read {
		color: var(--magenta);
	}
</style>
