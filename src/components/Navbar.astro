---
import NavbarApp from './react/Navbar';
import {
	getLocalizedPath,
	getPageLocaleSwitchHref,
	resolvePageContextFromPath,
	type PageId,
} from '../data/i18n/routing';
import { defaultLocale, locales, type LocaleCode } from '../data/i18n/locales';
import { reviewsBasePath } from '../data/reviews';
import { siteConfig } from '../data/site';
import { getForumBasePath, getForumLocaleSwitchHref, isForumPath } from '../data/forum/helpers';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
}

const { locale = defaultLocale, pageId: pageIdProp } = Astro.props;
const t = getT(locale);
const pathContext = resolvePageContextFromPath(Astro.url.pathname);
const pageId = pageIdProp ?? pathContext.pageId ?? 'home';
const current = Astro.url.pathname;
const onBlog = isForumPath(current);

const pageContext = onBlog
	? pathContext
	: {
			...pathContext,
			pageId: pathContext.pageId ?? pageId,
		};

function localeSwitchHref(targetLocale: LocaleCode): string {
	if (onBlog) return getForumLocaleSwitchHref(current, targetLocale);
	return getPageLocaleSwitchHref(pageContext, targetLocale);
}

const hrefForLocale = Object.fromEntries(
	locales.map((l) => [l.code, localeSwitchHref(l.code)]),
) as Record<string, string>;

const localeMetas = locales.map((l) => ({
	code: l.code,
	name: l.name,
	nativeName: l.nativeName,
	hreflang: l.hreflang,
	region: l.region,
}));

const links = [
	{ id: 'home', label: t('nav.home'), edit: 'navHome', href: getLocalizedPath('home', locale) },
	{ id: 'hacks', label: t('nav.preview'), edit: 'navPreview', href: getLocalizedPath('hacks', locale) },
	{ id: 'features', label: t('nav.features'), edit: 'navFeatures', href: getLocalizedPath('features', locale) },
	{ id: 'pricing', label: t('nav.store'), edit: 'navStore', href: getLocalizedPath('pricing', locale) },
	{ id: 'updates', label: t('nav.status'), edit: 'navStatus', href: getLocalizedPath('updates', locale) },
	{ id: 'forum', label: t('nav.forum'), edit: 'navForum', href: getForumBasePath(locale) },
	{ id: 'reviews', label: t('nav.reviews'), edit: 'navReviews', href: reviewsBasePath },
];

const uiLabels = {
	primaryAria: t('nav.primaryAria'),
	mobileAria: t('nav.mobileAria'),
	openMenu: t('nav.openMenu'),
	closeMenu: t('nav.closeMenu'),
	buyShort: t('cta.buyShort'),
	buy: t('cta.buy'),
};
---

<NavbarApp
	client:load
	locale={locale}
	siteName={siteConfig.name}
	logoUrl={siteConfig.logo}
	logoAlt={siteConfig.logoAlt}
	checkoutUrl={siteConfig.checkoutUrl}
	currentPath={current}
	homeHref={getLocalizedPath('home', locale)}
	reviewsBasePath={reviewsBasePath}
	locales={localeMetas}
	hrefForLocale={hrefForLocale}
	links={links}
	uiLabels={uiLabels}
/>

<style is:global>
	body.nav-lock {
		overflow: hidden;
	}

	.site-header .lang-switcher {
		position: relative;
	}

	.site-header .lang-switcher__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 2.15rem;
		padding: 0 0.65rem 0 0.75rem;
		border: 1px solid var(--line-soft);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 70%, transparent);
		color: var(--ink-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		cursor: pointer;
		transition:
			color 0.15s ease,
			background 0.15s ease,
			border-color 0.15s ease;
	}

	.site-header .lang-switcher__current {
		max-width: 6.5rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.site-header .lang-switcher__chevron {
		flex-shrink: 0;
		opacity: 0.65;
		transition: transform 0.18s ease;
	}

	.site-header .lang-switcher__chevron.is-open {
		transform: rotate(180deg);
	}

	.site-header .lang-switcher__toggle:hover {
		color: var(--ink);
		border-color: var(--line);
		background: var(--bg-elevated);
	}

	.site-header .lang-switcher__toggle svg {
		width: 0.85rem;
		height: 0.85rem;
		opacity: 0.75;
	}

	.site-header .lang-switcher__panel {
		position: absolute;
		right: 0;
		left: auto;
		top: calc(100% + 0.45rem);
		min-width: 16rem;
		max-height: min(70vh, 22rem);
		overflow-y: auto;
		overflow-x: hidden;
		overscroll-behavior: contain;
		padding: 0.5rem;
		background: var(--bg-elevated);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		box-shadow: 0 20px 48px rgba(0, 0, 0, 0.5);
		z-index: 120;
		scrollbar-width: thin;
		scrollbar-color: var(--line) transparent;
	}

	.site-header .lang-switcher__note {
		margin: 0 0 0.5rem;
		padding: 0.45rem 0.55rem;
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--bg) 60%, transparent);
		color: var(--ink-muted);
		font-size: 0.7rem;
		line-height: 1.4;
	}

	.site-header .lang-switcher__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.2rem;
	}

	.site-header .lang-switcher__link {
		display: grid;
		gap: 0.1rem;
		padding: 0.5rem 0.6rem;
		border-radius: 0.5rem;
		color: var(--ink);
		text-decoration: none;
	}

	.site-header .lang-switcher__native {
		font-size: 0.84rem;
		font-weight: 700;
	}

	.site-header .lang-switcher__region {
		font-size: 0.68rem;
		color: var(--ink-faint);
	}

	.site-header .lang-switcher__link {
		color: var(--ink);
	}

	.site-header .lang-switcher__link:hover,
	.site-header .lang-switcher__link.is-current {
		background: color-mix(in srgb, var(--magenta) 12%, transparent);
	}

	.site-panel .lang-switcher {
		width: 100%;
	}

	.site-panel .lang-switcher__toggle {
		width: 100%;
		justify-content: flex-start;
		height: 2.75rem;
		border-radius: var(--radius-sm);
	}

	.site-panel .lang-switcher__panel {
		position: static;
		margin-top: 0.45rem;
		max-height: 12rem;
		box-shadow: none;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		padding-top: var(--safe-top, env(safe-area-inset-top, 0px));
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-bottom: 1px solid transparent;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.site-header.is-scrolled,
	.site-header.is-open {
		background: color-mix(in srgb, var(--bg) 92%, transparent);
		border-bottom-color: var(--line-soft);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
	}

	.site-header__bar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		min-height: var(--header-h);
		gap: 0.75rem;
	}

	@media (min-width: 1025px) {
		.site-nav {
			position: absolute;
			left: 50%;
			top: 50%;
			transform: translate(-50%, -50%);
			z-index: 1;
		}
	}

	.site-brand {
		display: none;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		flex: 1 1 auto;
		margin-right: 0.5rem;
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.site-brand__logo {
		width: auto;
		height: 1.65rem;
		max-width: 5.25rem;
		flex-shrink: 0;
		object-fit: contain;
		border-radius: 0;
	}

	.site-brand__name {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.site-brand:hover {
		color: var(--magenta-soft);
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: nowrap;
		gap: 0.08rem;
		max-width: min(52rem, calc(100vw - 17.5rem));
		padding: 0.22rem;
		border: 1px solid var(--line-soft);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 65%, transparent);
		box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 5%, transparent);
	}

	.site-nav a {
		display: inline-flex;
		align-items: center;
		flex: 0 1 auto;
		min-width: 0;
		gap: 0.28rem;
		padding: 0.38rem 0.5rem;
		border-radius: 999px;
		font-size: clamp(0.72rem, 0.72vw, 0.8125rem);
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--ink-muted);
		white-space: nowrap;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}

	.site-nav a span {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.site-nav a svg {
		width: 0.88rem;
		height: 0.88rem;
		flex-shrink: 0;
		opacity: 0.72;
	}

	.site-nav a:hover {
		color: var(--ink);
		background: color-mix(in srgb, #fff 5%, transparent);
	}

	.site-nav a:hover svg,
	.site-nav a.is-active svg {
		opacity: 1;
		color: var(--magenta-soft);
	}

	.site-nav a.is-active {
		color: var(--ink);
		background: color-mix(in srgb, #fff 10%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, #fff 6%, transparent);
	}

	.site-tools {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.45rem;
		min-width: 0;
	}

	.site-tools__buy {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 2.15rem;
		height: auto;
		padding: 0 1rem;
		border-radius: 999px;
		background: #fff;
		color: #09090b;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		transition:
			background 0.15s ease,
			transform 0.15s ease;
	}

	.site-tools__buy svg {
		width: 0.9rem;
		height: 0.9rem;
	}

	.site-tools__buy:hover {
		background: #ececef;
		color: #09090b;
		transform: translateY(-1px);
	}

	.site-menu {
		display: none;
		align-items: center;
		justify-content: center;
		width: var(--touch-min, 2.75rem);
		height: var(--touch-min, 2.75rem);
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-elevated) 75%, transparent);
		color: var(--ink);
		flex-shrink: 0;
	}

	.site-menu__bars {
		display: grid;
		gap: 3.5px;
		width: 0.95rem;
	}

	.site-menu__bars span {
		display: block;
		height: 1.5px;
		border-radius: 999px;
		background: currentColor;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
		transform-origin: center;
	}

	.site-header.is-open .site-menu__bars span:nth-child(1) {
		transform: translateY(5px) rotate(45deg);
	}

	.site-header.is-open .site-menu__bars span:nth-child(2) {
		opacity: 0;
	}

	.site-header.is-open .site-menu__bars span:nth-child(3) {
		transform: translateY(-5px) rotate(-45deg);
	}

	.site-panel {
		border-top: 1px solid var(--line-soft);
		background: var(--bg);
		padding: 0.35rem 0 max(1.35rem, env(safe-area-inset-bottom, 0px));
		max-height: min(70dvh, calc(100dvh - var(--header-h)));
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior: contain;
		animation: panel-in 0.18s ease-out;
	}

	@keyframes panel-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.site-panel__nav {
		display: grid;
	}

	.site-panel__nav a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-height: var(--touch-min, 2.75rem);
		padding: 0.85rem 0.15rem;
		font-size: 1.05rem;
		font-weight: 500;
		letter-spacing: -0.015em;
		color: var(--ink-muted);
		border-bottom: 1px solid var(--line-soft);
	}

	.site-panel__nav a svg {
		width: 1.1rem;
		height: 1.1rem;
		color: var(--magenta-soft);
		opacity: 0.9;
	}

	.site-panel__nav a:hover,
	.site-panel__nav a.is-active {
		color: var(--ink);
	}

	.site-panel__nav a.is-active {
		color: var(--magenta-soft);
	}

	.site-panel__foot {
		display: grid;
		gap: 0.75rem;
		margin-top: 1.1rem;
	}

	.site-panel__buy {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.85rem;
		border-radius: 999px;
		background: #fff;
		color: #09090b;
		font-weight: 600;
	}

	.site-panel__buy:hover {
		background: #e4e4e7;
		color: #09090b;
	}

	@media (max-width: 1024px) {
		.site-nav,
		.site-tools__lang {
			display: none;
		}

		.site-brand {
			display: flex;
			flex: 1 1 auto;
			min-width: 0;
			max-width: none;
		}

		.site-header__bar {
			justify-content: space-between;
			gap: 0.55rem;
		}

		.site-tools__buy {
			min-height: var(--touch-min, 2.75rem);
			padding-inline: 0.85rem;
			font-size: 0.8rem;
			flex-shrink: 0;
		}

		.site-menu {
			display: inline-flex;
		}

		.site-header.is-open {
			background: var(--bg);
		}

		.site-panel {
			max-height: calc(100dvh - var(--header-h) - var(--safe-top, 0px) - var(--safe-bottom, 0px));
		}
	}

	@media (max-width: 480px) {
		.site-brand {
			font-size: 0.9rem;
		}

		.site-tools {
			gap: 0.4rem;
		}

		.site-tools__buy {
			padding-inline: 0.7rem;
		}
	}

	@media (max-width: 360px) {
		.site-tools__buy span {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.site-tools__buy {
			padding-inline: 0.7rem;
			min-width: var(--touch-min);
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.site-nav a,
		.site-tools__buy,
		.site-menu__bars span,
		.site-panel {
			transition: none;
			animation: none;
		}

		.site-tools__buy:hover {
			transform: none;
		}
	}
</style>
