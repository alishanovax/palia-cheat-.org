---
import { contentImageSrc, contentSrcSet, galleryTileSizes } from '../lib/responsive-images';

export type GallerySlide = {
	src: string;
	alt: string;
};

interface Props {
	slides: GallerySlide[];
	labelPrevious?: string;
	labelNext?: string;
	/** Fixed caption below the frame (does not change per slide). */
	staticCaption?: string;
	sizes?: string;
	/** Stretch frame to fill parent height (pricing panel beside carousel). */
	fillHeight?: boolean;
	/** Hide caption row under the frame. */
	hideCaption?: boolean;
}

const {
	slides,
	labelPrevious = 'Previous image',
	labelNext = 'Next image',
	staticCaption,
	sizes = galleryTileSizes,
	fillHeight = false,
	hideCaption = false,
} = Astro.props;

const prepared = slides.map((slide) => ({
	src: contentImageSrc(slide.src),
	srcSet: contentSrcSet(slide.src),
	alt: slide.alt,
}));

const carouselId = `gallery-${Math.random().toString(36).slice(2, 9)}`;
---

{
	prepared.length > 0 && (
		<div
			class:list={['gallery-carousel', fillHeight && 'gallery-carousel--fill', hideCaption && 'gallery-carousel--no-caption']}
			data-gallery-carousel
			id={carouselId}
			tabindex="0"
		>
			<div class="gallery-carousel__frame">
				<img
					class="gallery-carousel__img"
					data-gallery-img
					src={prepared[0].src}
					srcset={prepared[0].srcSet}
					sizes={sizes}
					alt={prepared[0].alt}
					width="1280"
					height="720"
					loading="lazy"
					decoding="async"
				/>
				{prepared.length > 1 && (
					<>
						<span class="gallery-carousel__counter" data-gallery-counter aria-live="polite">
							1 / {prepared.length}
						</span>
						<button
							type="button"
							class="gallery-carousel__nav gallery-carousel__nav--prev"
							data-gallery-prev
							aria-label={labelPrevious}
						>
							<svg viewBox="0 0 20 20" aria-hidden="true">
								<path d="M12.5 4.5 7.5 10l5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
						<button
							type="button"
							class="gallery-carousel__nav gallery-carousel__nav--next"
							data-gallery-next
							aria-label={labelNext}
						>
							<svg viewBox="0 0 20 20" aria-hidden="true">
								<path d="M7.5 4.5 12.5 10l-5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</button>
					</>
				)}
			</div>
			{!hideCaption && (
				<p class="gallery-carousel__caption" data-gallery-caption data-gallery-static-caption={staticCaption ? 'true' : undefined}>
					{staticCaption ?? prepared[0].alt}
				</p>
			)}
			<script
				type="application/json"
				data-gallery-slides
				set:html={JSON.stringify(prepared)}
			/>
		</div>
	)
}

<script>
	function initGalleryCarousel(root: HTMLElement) {
		if (root.dataset.galleryInitialized === 'true') return;
		root.dataset.galleryInitialized = 'true';

		const slidesEl = root.querySelector('[data-gallery-slides]');
		if (!slidesEl?.textContent) return;

		const slides = JSON.parse(slidesEl.textContent) as { src: string; srcSet: string; alt: string }[];
		if (slides.length <= 1) return;

		const img = root.querySelector<HTMLImageElement>('[data-gallery-img]');
		const counter = root.querySelector('[data-gallery-counter]');
		const caption = root.querySelector('[data-gallery-caption]');
		const staticCaption = caption?.getAttribute('data-gallery-static-caption') === 'true';
		const prev = root.querySelector<HTMLButtonElement>('[data-gallery-prev]');
		const next = root.querySelector<HTMLButtonElement>('[data-gallery-next]');
		if (!img || !counter || !prev || !next) return;

		let index = 0;

		const show = (nextIndex: number) => {
			index = (nextIndex + slides.length) % slides.length;
			const slide = slides[index];
			img.src = slide.src;
			if (slide.srcSet) img.srcset = slide.srcSet;
			else img.removeAttribute('srcset');
			img.alt = slide.alt;
			counter.textContent = `${index + 1} / ${slides.length}`;
			if (caption && !staticCaption) caption.textContent = slide.alt;
		};

		prev.addEventListener('click', () => show(index - 1));
		next.addEventListener('click', () => show(index + 1));

		root.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				show(index - 1);
			}
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				show(index + 1);
			}
		});
	}

	function boot() {
		document.querySelectorAll<HTMLElement>('[data-gallery-carousel]').forEach(initGalleryCarousel);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', boot, { once: true });
	} else {
		boot();
	}
	document.addEventListener('astro:page-load', boot);
</script>

<style>
	.gallery-carousel {
		display: grid;
		grid-template-rows: 1fr auto;
		gap: 0.75rem;
		min-height: 0;
	}

	.gallery-carousel--fill {
		height: 100%;
	}

	.gallery-carousel--fill .gallery-carousel__frame {
		aspect-ratio: auto;
		min-height: 0;
		height: 100%;
	}

	.gallery-carousel--no-caption {
		grid-template-rows: 1fr;
	}

	.gallery-carousel__frame {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		background: #0a0a0f;
		aspect-ratio: 16 / 9;
	}

	.gallery-carousel__img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.gallery-carousel__counter {
		position: absolute;
		top: 0.65rem;
		right: 0.65rem;
		z-index: 2;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.82);
		color: #fff;
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: 0.02em;
	}

	.gallery-carousel__nav {
		position: absolute;
		top: 50%;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.35rem;
		height: 2.35rem;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.88);
		color: #fff;
		cursor: pointer;
		transform: translateY(-50%);
		transition: background 0.15s ease, transform 0.15s ease;
	}

	.gallery-carousel__nav svg {
		width: 1.15rem;
		height: 1.15rem;
	}

	.gallery-carousel__nav:hover {
		background: #000;
	}

	.gallery-carousel__nav:focus-visible {
		outline: 2px solid var(--magenta-soft);
		outline-offset: 2px;
	}

	.gallery-carousel__nav--prev {
		left: 0.65rem;
	}

	.gallery-carousel__nav--next {
		right: 0.65rem;
	}

	.gallery-carousel__caption {
		margin: 0;
		text-align: center;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
</style>
