---
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import { paliaImages } from '../data/palia';
import GalleryCarousel from './GalleryCarousel.astro';
import { shopPreviewSizes } from '../lib/responsive-images';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];
const lifetime = productInfo.plans.find((p) => p.id === 'lifetime') ?? productInfo.plans[1];

const perks = [
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
		label: t('trustStrip.instantDelivery'),
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 8h12M8 12h8M10 16h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/></svg>`,
		label: t('deals.easyToUse'),
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.5 19 6.5v5.5c0 4.2-2.8 7.8-7 9.5-4.2-1.7-7-5.3-7-9.5V6.5l7-3z" stroke="currentColor" stroke-width="1.6"/></svg>`,
		label: t('categoryRow.undetected'),
	},
	{
		icon: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><rect x="2" y="14" width="6" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="16" y="14" width="6" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/></svg>`,
		label: t('trustStrip.support247'),
	},
];

const previewSlides = [...paliaImages.product, ...paliaImages.gallery].filter((image, index, list) => {
	return list.findIndex((item) => item.src === image.src) === index;
});
---

<section class="shop" aria-labelledby="shop-title">
	<div class="shell">
		<div class="shop__card">
			<div class="shop__media">
				<GalleryCarousel
					slides={previewSlides.map((image) => ({ src: image.src, alt: image.alt }))}
					sizes={shopPreviewSizes}
					fillHeight={true}
					hideCaption={true}
					labelPrevious={t('gallery.previous')}
					labelNext={t('gallery.next')}
				/>
			</div>

			<div class="shop__panel">
				<header class="shop__panel-head">
					<h2 id="shop-title" class="shop__title">{t('deals.sectionTitle')}</h2>
					<span class="shop__status">
						<span class="shop__status-dot" aria-hidden="true" />
						{t('categoryRow.undetected')}
					</span>
				</header>

				<div class="shop__tiers" data-plan-picker>
					<button
						type="button"
						class="shop__tier is-active"
						data-plan="monthly"
						aria-pressed="true"
					>
						<span class="shop__tier-label">{t('product.monthly')}</span>
						<span class="shop__tier-price">${monthly.price}</span>
					</button>

					<button
						type="button"
						class="shop__tier shop__tier--popular"
						data-plan="lifetime"
						aria-pressed="false"
					>
						<span class="shop__tier-badge">{t('deals.mostPopular')}</span>
						<span class="shop__tier-row">
							<span class="shop__tier-label">{t('product.lifetime')}</span>
							<span class="shop__tier-price">${lifetime.price}</span>
						</span>
						<span class="shop__tier-meta">{t('product.oneTime')}</span>
					</button>
				</div>

				<a class="shop__buy" href={siteConfig.checkoutUrl} rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M6 6h15l-1.5 9h-12L6 6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
						<circle cx="9" cy="20" r="1.2" fill="currentColor"/>
						<circle cx="18" cy="20" r="1.2" fill="currentColor"/>
						<path d="M6 6 5 3H2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
					</svg>
					{t('deals.getAccess')}
				</a>

				<ul class="shop__perks">
					{perks.map((perk) => (
						<li>
							<span class="shop__perk-icon" set:html={perk.icon} />
							<span>{perk.label}</span>
						</li>
					))}
				</ul>

				<p class="shop__guarantee">
					<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path d="M12 3.5 19 6.5v5.5c0 4.2-2.8 7.8-7 9.5-4.2-1.7-7-5.3-7-9.5V6.5l7-3z" stroke="currentColor" stroke-width="1.6"/>
						<path d="M9.5 12.2 11.3 14l3.7-3.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
					{t('deals.guarantee')}
				</p>
			</div>
		</div>
	</div>
</section>

<script>
	function initPlanPicker(root: HTMLElement) {
		if (root.dataset.planPickerInit === 'true') return;
		root.dataset.planPickerInit = 'true';

		const tiers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-plan]'));
		if (tiers.length < 2) return;

		const setActive = (active: HTMLButtonElement) => {
			tiers.forEach((tier) => {
				const isActive = tier === active;
				tier.classList.toggle('is-active', isActive);
				tier.setAttribute('aria-pressed', isActive ? 'true' : 'false');
			});
		};

		tiers.forEach((tier) => {
			tier.addEventListener('click', () => setActive(tier));
		});
	}

	function bootPlanPickers() {
		document.querySelectorAll<HTMLElement>('[data-plan-picker]').forEach(initPlanPicker);
	}

	bootPlanPickers();
	document.addEventListener('astro:page-load', bootPlanPickers);
</script>

<style>
	.shop {
		padding-block: clamp(2.5rem, 5vw, 3.5rem);
		background: var(--bg);
		border-top: 1px solid var(--line-soft);
	}

	.shop__card {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		overflow: hidden;
	}

	.shop__media {
		min-width: 0;
		min-height: 100%;
		display: flex;
		padding: 0.85rem;
		border-right: 1px solid var(--line);
		background: color-mix(in srgb, var(--bg) 65%, var(--bg-panel));
	}

	.shop__media :global(.gallery-carousel) {
		flex: 1;
		min-height: 100%;
		width: 100%;
	}

	.shop__media :global(.gallery-carousel__frame) {
		border-color: var(--line);
		border-radius: calc(var(--radius-md) - 0.15rem);
		min-height: clamp(16rem, 38vw, 24rem);
	}

	.shop__panel {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: clamp(1rem, 2.5vw, 1.35rem);
		min-width: 0;
	}

	.shop__panel-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.shop__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.4vw, 1.65rem);
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.shop__status {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.28rem 0.6rem;
		border: 1px solid color-mix(in srgb, var(--magenta) 35%, var(--line));
		border-radius: 999px;
		background: color-mix(in srgb, var(--magenta) 10%, transparent);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--magenta-soft);
		white-space: nowrap;
	}

	.shop__status-dot {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 999px;
		background: var(--magenta-soft);
		box-shadow: 0 0 0.45rem color-mix(in srgb, var(--magenta-soft) 70%, transparent);
	}

	.shop__tiers {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.65rem;
	}

	.shop__tier {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		justify-content: center;
		gap: 0.2rem;
		min-height: 4.6rem;
		padding: 0.75rem 0.85rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--bg) 55%, var(--bg-panel));
		color: var(--ink);
		text-align: left;
		cursor: pointer;
		transition: border-color 0.15s ease, background 0.15s ease;
	}

	.shop__tier:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
	}

	.shop__tier.is-active {
		border-color: color-mix(in srgb, var(--magenta) 55%, var(--line));
		background: color-mix(in srgb, var(--magenta) 8%, var(--bg-panel));
	}

	.shop__tier--popular {
		padding-top: 1.35rem;
	}

	.shop__tier-badge {
		position: absolute;
		top: 0.45rem;
		left: 50%;
		transform: translateX(-50%);
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--magenta-soft);
		white-space: nowrap;
	}

	.shop__tier-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		width: 100%;
	}

	.shop__tier-label {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--ink-muted);
	}

	.shop__tier.is-active .shop__tier-label {
		color: var(--magenta-soft);
	}

	.shop__tier-price {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.shop__tier-meta {
		font-size: 0.72rem;
		color: var(--ink-faint);
	}

	.shop__buy {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		width: 100%;
		min-height: 3rem;
		border: none;
		border-radius: var(--radius-sm);
		background: linear-gradient(90deg, var(--magenta-deep), var(--magenta), var(--magenta-soft));
		font-size: 0.95rem;
		font-weight: 700;
		color: #fff;
		text-decoration: none;
		box-shadow: 0 0.35rem 1.25rem color-mix(in srgb, var(--magenta) 28%, transparent);
		transition: filter 0.15s ease, transform 0.15s ease;
	}

	.shop__buy svg {
		width: 1.15rem;
		height: 1.15rem;
		flex-shrink: 0;
	}

	.shop__buy:hover {
		filter: brightness(1.06);
		transform: translateY(-1px);
		color: #fff;
	}

	.shop__perks {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.55rem 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.shop__perks li {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		min-width: 0;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--ink-muted);
	}

	.shop__perk-icon {
		display: grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		flex-shrink: 0;
		color: var(--magenta-soft);
	}

	.shop__perk-icon :global(svg) {
		width: 1rem;
		height: 1rem;
	}

	.shop__guarantee {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		margin: 0;
		padding: 0.75rem 0.85rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: color-mix(in srgb, var(--bg) 50%, var(--bg-panel));
		font-size: 0.74rem;
		line-height: 1.45;
		color: var(--ink-faint);
	}

	.shop__guarantee svg {
		width: 1rem;
		height: 1rem;
		margin-top: 0.1rem;
		flex-shrink: 0;
		color: var(--magenta-soft);
	}

	@media (max-width: 900px) {
		.shop__card {
			grid-template-columns: 1fr;
		}

		.shop__media {
			border-right: none;
			border-bottom: 1px solid var(--line);
		}

		.shop__media :global(.gallery-carousel__frame) {
			min-height: clamp(14rem, 52vw, 20rem);
		}
	}

	@media (max-width: 520px) {
		.shop__tiers {
			grid-template-columns: 1fr;
		}

		.shop__perks {
			grid-template-columns: 1fr;
		}

		.shop__panel-head {
			flex-wrap: wrap;
		}
	}
</style>
