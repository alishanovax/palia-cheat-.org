---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import { forumUi, type LocaleCode, defaultLocale } from '../data/i18n/locales';
import {
	absoluteForumUrl,
	getAllPostsForLocale,
	getForumBasePath,
	getForumIndexHreflangAlternates,
} from '../data/forum/helpers';
import { forumLabel, siteConfig } from '../data/site';
import { brandSeo, seoPageTitle } from '../data/site-core';
import { seoDescription } from '../data/brand';
import { getLocalizedPath } from '../data/i18n/routing';
import { getT } from '../i18n/server';
import ForumArticleCard from './ForumArticleCard.astro';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const ui = forumUi[locale];
const t = getT(locale);
const posts = getAllPostsForLocale(locale);
const canonicalPath = getForumBasePath(locale);
const canonicalURL = absoluteForumUrl(locale);
const hreflangAlternates = getForumIndexHreflangAlternates(locale);
const homeHref = getLocalizedPath('home', locale);

const pageTitle = locale === defaultLocale ? seoPageTitle(brandSeo.forumTitle) : ui.forumTitle;
const pageDescription =
	locale === defaultLocale ? seoDescription(brandSeo.forumDescription) : ui.forumDescription;

const articleListSchema = {
	'@type': 'CollectionPage',
	'@id': `${canonicalURL}#collection`,
	name: ui.forumH1,
	description: pageDescription,
	url: canonicalURL,
	inLanguage: locale,
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: posts.map((post, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: absoluteForumUrl(locale, post.translation.slug),
			name: post.translation.title,
		})),
	},
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalPath={canonicalPath}
	hreflangAlternates={hreflangAlternates}
	locale={locale}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={ui.forumH1}
	breadcrumbs={[{ label: ui.home, href: homeHref }, { label: ui.forumH1 }]}
	extraGraph={[articleListSchema]}
>
	<Navbar locale={locale} />
	<main class="blog">
		<div class="shell blog__inner">
		<nav class="blog__crumbs" aria-label="Breadcrumb">
			<a href={homeHref}>{ui.home}</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">{ui.forumH1}</span>
		</nav>
		<header class="blog__hero">
			<p class="blog__eyebrow" data-edit="forumLabel">{forumLabel}</p>
			<h1>{ui.forumH1}</h1>
			<p class="blog__intro">{ui.forumIntro}</p>
		</header>

		<section class="blog__list" aria-label={ui.allPosts}>
			{
				posts.map((post) => (
					<ForumArticleCard
						category={post.category}
						title={post.translation.title}
						copy={post.translation.metaDescription}
						href={post.canonicalPath}
						readLabel={t('homeForums.readArticle')}
					/>
				))
			}
		</section>
		</div>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.blog {
		padding: 2.5rem 0 4rem;
	}

	.blog__inner {
		display: grid;
		gap: 0;
	}

	.blog__crumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 1.25rem;
		font-size: 0.8rem;
		color: var(--ink-faint);
	}

	.blog__crumbs a {
		color: var(--ink-muted);
		font-weight: 600;
		text-decoration: none;
	}

	.blog__crumbs a:hover {
		color: var(--magenta-soft);
	}

	.blog__hero {
		margin-bottom: 2.5rem;
	}
	.blog__eyebrow {
		margin: 0 0 0.5rem;
		color: var(--magenta-soft);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: 0.75rem;
	}
	.blog__hero h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		line-height: 1.05;
	}
	.blog__intro {
		max-width: 42rem;
		color: rgba(255, 255, 255, 0.72);
		font-size: 1.05rem;
	}
	.blog__list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem;
	}
	@media (max-width: 960px) {
		.blog__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.blog__list {
			grid-template-columns: 1fr;
			gap: 0.85rem;
		}
	}

</style>
