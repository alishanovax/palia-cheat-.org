---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import { forumUi, defaultLocale, type LocaleCode } from '../data/i18n/locales';
import {
	absoluteForumUrl,
	getAllPostsForLocale,
	getForumBasePath,
	getBlogPostHreflangAlternates,
} from '../data/forum/helpers';
import type { ResolvedBlogPost } from '../data/forum/types';
import { descriptiveAlt } from '../data/palia';
import { forumLabel, siteConfig } from '../data/site';
import { getLocalizedPath, localizeInternalHref } from '../data/i18n/routing';

interface Props {
	locale: LocaleCode;
	post: ResolvedBlogPost;
}

const { locale, post } = Astro.props;
const ui = forumUi[locale];
const t = post.translation;
const homeHref = getLocalizedPath('home', locale);
const blogHref = getForumBasePath(defaultLocale);
const related = getAllPostsForLocale(defaultLocale)
	.filter((p) => p.id !== post.id)
	.slice(0, 3);

const articleUrl = absoluteForumUrl(defaultLocale, post.translations[defaultLocale]?.slug ?? t.slug);
const heroAlt = descriptiveAlt(post.imageSrc);
const hreflangAlternates = getBlogPostHreflangAlternates(post, locale);
const articleSchema = {
	'@type': 'Article',
	'@id': `${articleUrl}#article`,
	url: articleUrl,
	headline: t.title,
	description: t.metaDescription,
	datePublished: post.published,
	dateModified: post.updated,
	image: new URL(post.imageSrc, siteConfig.url).href,
	inLanguage: locale,
	author: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
	publisher: {
		'@type': 'Organization',
		name: siteConfig.name,
		url: siteConfig.url,
		logo: { '@type': 'ImageObject', url: new URL(siteConfig.logoRaster, siteConfig.url).href },
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': `${articleUrl}#webpage`,
	},
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	keywords: t.keywords.join(', '),
	articleSection: post.category,
};

function localizeParagraphHtml(html: string): string {
	return html.replace(/href="(\/[^"]+)"/g, (_, path: string) => {
		return `href="${localizeInternalHref(path, locale)}"`;
	});
}

/** Keep document titles within ~60 chars without cutting mid-word. */
function pageTitle(headline: string): string {
	const suffix = ` | ${forumLabel}`;
	if (headline.length + suffix.length <= 60) return `${headline}${suffix}`;
	if (headline.length <= 60) return headline;
	const trimmed = headline.slice(0, 57);
	const cut = trimmed.lastIndexOf(' ');
	return `${(cut > 40 ? trimmed.slice(0, cut) : trimmed).replace(/[|:–—-]+$/, '').trim()}…`;
}
---

<Layout
	title={pageTitle(t.title)}
	description={t.metaDescription}
	canonicalPath={post.canonicalPath}
	hreflangAlternates={hreflangAlternates}
	ogImage={post.imageSrc}
	ogImageAlt={heroAlt}
	type="article"
	locale={locale}
	breadcrumbs={[
		{ label: ui.home, href: homeHref },
		{ label: ui.forumH1, href: blogHref },
		{ label: t.h1 },
	]}
	extraGraph={[articleSchema]}
>
	<Navbar locale={locale} />
	<main class="post">
		<div class="shell">
			<div class="shell-content post__inner">
		<article>
			<header class="post__header">
				<p class="post__cat">{post.category}</p>
				<h1>{t.h1}</h1>
				<p class="post__intro">{t.intro}</p>
				<p class="post__meta">
					{ui.published} {post.published} · {ui.updated} {post.updated}
				</p>
			</header>
			<img
				class="post__hero"
				src={post.imageSrc}
				alt={heroAlt}
				width="1200"
				height="675"
				loading="eager"
				decoding="async"
			/>
			{
				t.sections.map((section) => (
					<section class="post__section">
						<h2>{section.h2}</h2>
						{section.paragraphs.map((paragraph) => {
							const isTip = paragraph.startsWith('Pro Tip');
							const isTry = paragraph.startsWith('Try This Today');
							const html = localizeParagraphHtml(paragraph);
							if (isTip || isTry) {
								return (
									<aside class:list={['callout', { 'callout--tip': isTip, 'callout--try': isTry }]}>
										<p set:html={html} />
									</aside>
								);
							}
							return <p set:html={html} />;
						})}
					</section>
				))
			}
		</article>

		{
			related.length > 0 && (
				<section class="post__related" aria-label={ui.relatedPosts}>
					<h2>{ui.relatedPosts}</h2>
					<div class="post__related-grid">
						{related.map((item) => (
							<a class="post__related-card" href={item.canonicalPath}>
								<span class="post__cat">{item.category}</span>
								<span class="post__related-title">{item.translation.title}</span>
								<span class="post__related-more">{ui.readMore}</span>
							</a>
						))}
					</div>
				</section>
			)
		}
			</div>
		</div>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.post {
		padding: 2.5rem 0 4rem;
	}

	.post__inner {
		display: grid;
		gap: 0;
	}
	.post__cat {
		margin: 0 0 0.5rem;
		color: var(--magenta-soft);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.post__header h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(1.9rem, 4vw, 2.8rem);
		line-height: 1.1;
	}
	.post__intro {
		color: rgba(255, 255, 255, 0.78);
		font-size: 1.08rem;
	}
	.post__meta {
		color: rgba(255, 255, 255, 0.5);
		font-size: 0.85rem;
	}
	.post__hero {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		margin: 1.5rem 0 2rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
	}
	.post__section {
		margin-bottom: 1.75rem;
	}
	.post__section h2 {
		margin: 0 0 0.75rem;
		font-size: 1.35rem;
	}
	.post__section p {
		margin: 0 0 0.9rem;
		color: rgba(255, 255, 255, 0.78);
		line-height: 1.7;
	}
	.callout {
		margin: 0 0 1rem;
		padding: 0.9rem 1rem;
		border-radius: var(--radius-md, 0.75rem);
		border: 1px solid color-mix(in srgb, var(--magenta) 35%, var(--line));
		background: color-mix(in srgb, var(--magenta) 10%, var(--bg-panel));
	}
	.callout--try {
		border-color: rgba(52, 211, 153, 0.4);
		background: rgba(52, 211, 153, 0.08);
	}
	.callout p {
		margin: 0;
		color: rgba(255, 255, 255, 0.92);
	}
	.post__related {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}
	.post__related h2 {
		margin: 0 0 1rem;
		font-size: 1.15rem;
	}

	.post__related-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.post__related-card {
		display: flex;
		flex-direction: column;
		min-height: 9rem;
		padding: 1rem 1.05rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		background: var(--bg-panel);
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.post__related-card:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		transform: translateY(-2px);
	}

	.post__related-title {
		margin: 0.45rem 0 0.5rem;
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.3;
		color: var(--ink);
	}

	.post__related-more {
		margin-top: auto;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--magenta-soft);
	}

	@media (max-width: 760px) {
		.post__related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
