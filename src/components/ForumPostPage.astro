---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import ForumArticleCard from './ForumArticleCard.astro';
import { forumUi, defaultLocale, type LocaleCode } from '../data/i18n/locales';
import {
	absoluteForumUrl,
	getAllPostsForLocale,
	getForumBasePath,
	getBlogPostHreflangAlternates,
} from '../data/forum/helpers';
import type { ResolvedBlogPost } from '../data/forum/types';
import { descriptiveAlt } from '../data/palia';
import { forumLabel, productInfo, siteConfig } from '../data/site';
import { getLocalizedPath, localizeInternalHref } from '../data/i18n/routing';
import { getT } from '../i18n/server';
import { contentImageSrc, contentSrcSet } from '../lib/responsive-images';

interface Props {
	locale: LocaleCode;
	post: ResolvedBlogPost;
}

const { locale, post } = Astro.props;
const ui = forumUi[locale];
const t = getT(locale);
const tr = post.translation;
const homeHref = getLocalizedPath('home', locale);
const forumHref = getForumBasePath(locale);
const featuresHref = getLocalizedPath('features', locale);
const storeHref = getLocalizedPath('pricing', locale);
const statusHref = getLocalizedPath('updates', locale);
const related = getAllPostsForLocale(locale)
	.filter((p) => p.id !== post.id)
	.slice(0, 3);

const articleUrl = absoluteForumUrl(defaultLocale, post.translations[defaultLocale]?.slug ?? tr.slug);
const heroAlt = descriptiveAlt(post.imageSrc);
const hreflangAlternates = getBlogPostHreflangAlternates(post, locale);
const heroSrc = contentImageSrc(post.imageSrc);
const heroSrcSet = contentSrcSet(post.imageSrc);

const dateFormatter = new Intl.DateTimeFormat(locale, {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
	timeZone: 'UTC',
});

function formatDate(isoDate: string): string {
	return dateFormatter.format(new Date(`${isoDate}T00:00:00Z`));
}

const wordCount =
	tr.intro.split(/\s+/).length +
	tr.sections.reduce(
		(sum, section) =>
			sum + section.h2.split(/\s+/).length + section.paragraphs.join(' ').split(/\s+/).length,
		0,
	);
const readMinutes = Math.max(2, Math.round(wordCount / 220));

const articleSchema = {
	'@type': 'Article',
	'@id': `${articleUrl}#article`,
	url: articleUrl,
	headline: tr.title,
	description: tr.metaDescription,
	datePublished: post.published,
	dateModified: post.updated,
	image: new URL(post.imageSrc, siteConfig.url).href,
	inLanguage: locale,
	author: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
	publisher: {
		'@type': 'Organization',
		name: siteConfig.name,
		url: siteConfig.url,
		logo: { '@type': 'ImageObject', url: new URL(siteConfig.logoRaster, siteConfig.url).href },
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': `${articleUrl}#webpage`,
	},
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	keywords: tr.keywords.join(', '),
	articleSection: post.category,
};

function localizeParagraphHtml(html: string): string {
	return html.replace(/href="(\/[^"]+)"/g, (_, path: string) => {
		return `href="${localizeInternalHref(path, locale)}"`;
	});
}

/** Keep document titles within ~60 chars without cutting mid-word. */
function pageTitle(headline: string): string {
	const suffix = ` | ${forumLabel}`;
	if (headline.length + suffix.length <= 60) return `${headline}${suffix}`;
	if (headline.length <= 60) return headline;
	const trimmed = headline.slice(0, 57);
	const cut = trimmed.lastIndexOf(' ');
	return `${(cut > 40 ? trimmed.slice(0, cut) : trimmed).replace(/[|:–—-]+$/, '').trim()}…`;
}
---

<Layout
	title={pageTitle(tr.title)}
	description={tr.metaDescription}
	canonicalPath={post.canonicalPath}
	hreflangAlternates={hreflangAlternates}
	ogImage={post.imageSrc}
	ogImageAlt={heroAlt}
	type="article"
	locale={locale}
	breadcrumbs={[
		{ label: ui.home, href: homeHref },
		{ label: ui.forumH1, href: forumHref },
		{ label: tr.h1 },
	]}
	extraGraph={[articleSchema]}
>
	<Navbar locale={locale} />
	<main class="forum-post">
		<div class="shell forum-post__wrap">
			<nav class="forum-post__crumbs" aria-label="Breadcrumb">
				<a href={homeHref}>{ui.home}</a>
				<span aria-hidden="true">/</span>
				<a href={forumHref}>{ui.forumH1}</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{post.category}</span>
			</nav>

			<a class="forum-post__back" href={forumHref}>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M15 18l-6-6 6-6"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				{ui.allPosts}
			</a>

			<article class="forum-post__card">
				<div class="forum-post__hero">
					<figure class="forum-post__media">
						<img
							src={heroSrc}
							srcset={heroSrcSet}
							sizes="(max-width: 900px) 100vw, min(52vw, 34rem)"
							alt={heroAlt}
							width="1200"
							height="675"
							loading="eager"
							decoding="async"
						/>
					</figure>

					<header class="forum-post__head">
						<p class="forum-post__badge">{post.category}</p>
						<h1>{tr.h1}</h1>
						<p class="forum-post__intro">{tr.intro}</p>
						<ul class="forum-post__meta">
							<li>
								<span class="forum-post__meta-label">{ui.published}</span>
								<time datetime={post.published}>{formatDate(post.published)}</time>
							</li>
							<li>
								<span class="forum-post__meta-label">{ui.updated}</span>
								<time datetime={post.updated}>{formatDate(post.updated)}</time>
							</li>
							<li>
								<span class="forum-post__meta-label">Read time</span>
								<span>{readMinutes} min</span>
							</li>
						</ul>
					</header>
				</div>

				<div class="forum-post__content">
					{
						tr.sections.map((section, index) => (
							<section class="forum-post__section">
								<div class="forum-post__section-head">
									<span class="forum-post__section-num" aria-hidden="true">
										{String(index + 1).padStart(2, '0')}
									</span>
									<h2>{section.h2}</h2>
								</div>
								<div class="forum-post__section-body">
									{section.paragraphs.map((paragraph) => {
										const isTip = paragraph.startsWith('Pro Tip');
										const isTry = paragraph.startsWith('Try This Today');
										const html = localizeParagraphHtml(paragraph);
										if (isTip || isTry) {
											return (
												<aside
													class:list={[
														'forum-post__callout',
														{ 'forum-post__callout--try': isTry },
													]}
												>
													<p set:html={html} />
												</aside>
											);
										}
										return <p set:html={html} />;
									})}
								</div>
							</section>
						))
					}
				</div>

				<aside class="forum-post__cta" aria-label={`Buy ${siteConfig.name}`}>
					<div class="forum-post__cta-copy">
						<p class="forum-post__cta-title">Try {siteConfig.name}</p>
						<p class="forum-post__cta-lede">
							ESP, fishing tools, teleport, and cheat menu in one license for {productInfo.game} on
							Windows PC.
						</p>
					</div>
					<div class="forum-post__cta-actions">
						<a class="forum-post__cta-buy" href={siteConfig.checkoutUrl} rel="noopener noreferrer">
							Buy now — ${productInfo.plans[0].price}
						</a>
						<a class="forum-post__cta-link" href={featuresHref}>Features</a>
						<a class="forum-post__cta-link" href={storeHref}>Store</a>
						<a class="forum-post__cta-link" href={statusHref}>Status</a>
					</div>
				</aside>
			</article>

			{
				related.length > 0 && (
					<section class="forum-post__related" aria-labelledby="forum-related-title">
						<div class="forum-post__related-head">
							<h2 id="forum-related-title">{ui.relatedPosts}</h2>
							<a class="forum-post__related-all" href={forumHref}>
								{ui.allPosts}
								<span aria-hidden="true">→</span>
							</a>
						</div>
						<div class="forum-post__related-grid">
							{related.map((item) => (
								<ForumArticleCard
									category={item.category}
									title={item.translation.title}
									copy={item.translation.metaDescription}
									href={item.canonicalPath}
									readLabel={t('homeForums.readArticle')}
								/>
							))}
						</div>
					</section>
				)
			}
		</div>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.forum-post {
		overflow-x: clip;
		padding-block: 2rem 3.5rem;
	}

	.forum-post__wrap {
		display: grid;
		gap: 1.25rem;
	}

	.forum-post__crumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.8rem;
		color: var(--ink-faint);
	}

	.forum-post__crumbs a {
		color: var(--ink-muted);
		font-weight: 600;
		text-decoration: none;
	}

	.forum-post__crumbs a:hover {
		color: var(--magenta-soft);
	}

	.forum-post__back {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		width: fit-content;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-muted);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.forum-post__back:hover {
		color: var(--magenta-soft);
	}

	.forum-post__card {
		display: grid;
		gap: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg, 1rem);
		background:
			radial-gradient(ellipse 80% 55% at 0% 0%, color-mix(in srgb, var(--magenta) 12%, transparent), transparent 58%),
			var(--bg-panel);
		overflow: hidden;
		box-shadow: 0 18px 48px color-mix(in srgb, #000 28%, transparent);
	}

	.forum-post__hero {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: 0;
		border-bottom: 1px solid var(--line-soft);
	}

	.forum-post__media {
		margin: 0;
		min-height: 100%;
		background: var(--bg-elevated);
	}

	.forum-post__media img {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 16rem;
		object-fit: cover;
	}

	.forum-post__head {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.75rem;
		padding: clamp(1.25rem, 3vw, 2rem);
	}

	.forum-post__badge {
		margin: 0;
		display: inline-flex;
		align-self: flex-start;
		padding: 0.28rem 0.65rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--magenta) 35%, var(--line));
		background: color-mix(in srgb, var(--magenta) 12%, var(--bg));
		color: var(--magenta-soft);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.forum-post__head h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.55rem, 3.2vw, 2.35rem);
		font-weight: 800;
		line-height: 1.12;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.forum-post__intro {
		margin: 0;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--ink-muted);
		max-width: 38rem;
	}

	.forum-post__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1.1rem;
		margin: 0.15rem 0 0;
		padding: 0;
		list-style: none;
	}

	.forum-post__meta li {
		display: grid;
		gap: 0.12rem;
	}

	.forum-post__meta-label {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.forum-post__meta time,
	.forum-post__meta span {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink);
	}

	.forum-post__content {
		display: grid;
		gap: 1.15rem;
		padding: clamp(1.25rem, 3vw, 2rem);
	}

	.forum-post__section {
		padding: 1.15rem 1.2rem;
		border: 1px solid var(--line-soft);
		border-radius: var(--radius-md, 0.75rem);
		background: color-mix(in srgb, var(--bg-elevated) 88%, var(--bg-panel));
	}

	.forum-post__section-head {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
		margin-bottom: 0.85rem;
	}

	.forum-post__section-num {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2rem;
		height: 2rem;
		padding: 0 0.35rem;
		border-radius: 0.55rem;
		background: color-mix(in srgb, var(--magenta) 14%, var(--bg));
		border: 1px solid color-mix(in srgb, var(--magenta) 28%, var(--line));
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		color: var(--magenta-soft);
	}

	.forum-post__section h2 {
		margin: 0.15rem 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 2vw, 1.28rem);
		font-weight: 700;
		line-height: 1.35;
		color: var(--ink);
	}

	.forum-post__section-body {
		display: grid;
		gap: 0.85rem;
	}

	.forum-post__section-body :global(p) {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.72;
		color: var(--ink-muted);
	}

	.forum-post__section-body :global(a) {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.14em;
	}

	.forum-post__section-body :global(a:hover) {
		color: var(--magenta);
	}

	.forum-post__section-body :global(strong) {
		color: var(--ink);
		font-weight: 700;
	}

	.forum-post__callout {
		margin: 0;
		padding: 0.95rem 1rem;
		border-radius: var(--radius-md, 0.75rem);
		border: 1px solid color-mix(in srgb, var(--magenta) 35%, var(--line));
		background: color-mix(in srgb, var(--magenta) 10%, var(--bg-panel));
	}

	.forum-post__callout--try {
		border-color: color-mix(in srgb, var(--ok) 40%, var(--line));
		background: color-mix(in srgb, var(--ok) 10%, var(--bg-panel));
	}

	.forum-post__callout :global(p) {
		margin: 0;
		color: var(--ink);
	}

	.forum-post__cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.25rem;
		margin: 0 clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2rem);
		padding: 1.15rem 1.2rem;
		border-radius: var(--radius-md, 0.75rem);
		border: 1px solid color-mix(in srgb, var(--magenta) 28%, var(--line));
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--magenta) 10%, var(--bg-elevated)), var(--bg-panel));
	}

	.forum-post__cta-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 800;
		color: var(--ink);
	}

	.forum-post__cta-lede {
		margin: 0.3rem 0 0;
		max-width: 34rem;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.forum-post__cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.forum-post__cta-buy {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.65rem;
		padding: 0 1.2rem;
		border-radius: 999px;
		background: linear-gradient(90deg, var(--magenta-deep), var(--magenta), var(--magenta-soft));
		font-size: 0.875rem;
		font-weight: 700;
		color: #fff;
		text-decoration: none;
		box-shadow: 0 0.35rem 1.25rem color-mix(in srgb, var(--magenta) 28%, transparent);
		transition:
			filter 0.15s ease,
			transform 0.15s ease;
	}

	.forum-post__cta-buy:hover {
		filter: brightness(1.06);
		transform: translateY(-1px);
		color: #fff;
	}

	.forum-post__cta-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.65rem;
		padding: 0 1rem;
		border-radius: 999px;
		border: 1px solid var(--line-strong);
		background: var(--bg-elevated);
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.forum-post__cta-link:hover {
		border-color: color-mix(in srgb, var(--magenta) 40%, var(--line-strong));
		color: var(--magenta-soft);
	}

	.forum-post__related {
		display: grid;
		gap: 1rem;
		padding-top: 0.5rem;
	}

	.forum-post__related-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.forum-post__related-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 2.2vw, 1.45rem);
		font-weight: 800;
		color: var(--ink);
	}

	.forum-post__related-all {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-muted);
		text-decoration: none;
		white-space: nowrap;
	}

	.forum-post__related-all:hover {
		color: var(--magenta-soft);
	}

	.forum-post__related-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem;
	}

	@media (max-width: 960px) {
		.forum-post__hero {
			grid-template-columns: 1fr;
		}

		.forum-post__media img {
			min-height: 12rem;
			max-height: 18rem;
		}

		.forum-post__related-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.forum-post__cta {
			flex-direction: column;
			align-items: stretch;
		}

		.forum-post__cta-actions {
			flex-direction: column;
		}

		.forum-post__cta-buy,
		.forum-post__cta-link {
			width: 100%;
		}

		.forum-post__related-head {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
