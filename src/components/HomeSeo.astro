---
import { fillBrandTokens, homeFaqs } from '../data/site';
import { getFaqBySlug, getFaqPath, indexedFaqSlugs } from '../data/faq';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getT } from '../i18n/server';

type HomeLinks = {
	cheats: string;
	esp: string;
	aimbot: string;
	updates: string;
	features: string;
	pricing: string;
	faq: string;
	support: string;
	setup: string;
	teleport: string;
	wallhack: string;
	forum: string;
	refunds: string;
};

interface Props {
	locale?: LocaleCode;
	links: HomeLinks;
}

const locale = Astro.props.locale ?? defaultLocale;
const { links } = Astro.props;
const t = getT(locale);

const faqs = homeFaqs.map((item) => ({
	slug: item.slug,
	question: fillBrandTokens(item.question),
	answer: fillBrandTokens(item.answer),
	href: getFaqPath(item.slug),
}));

const indexedFaqLinks = [...indexedFaqSlugs]
	.map((slug) => getFaqBySlug(slug))
	.filter((item): item is NonNullable<typeof item> => Boolean(item))
	.map((item) => ({
		href: getFaqPath(item.slug),
		question: fillBrandTokens(item.question),
	}));

const pillarLinks = [
	{ href: links.cheats, label: t('homeSeo.linkPaliaCheats') },
	{ href: links.esp, label: t('homeSeo.linkEsp') },
	{ href: links.aimbot, label: t('homeSeo.linkAimbot') },
	{ href: links.teleport, label: t('homeSeo.linkTeleport') },
	{ href: links.features, label: t('homeSeo.linkAllFeatures') },
	{ href: links.pricing, label: t('homeSeo.linkPlans') },
	{ href: links.setup, label: t('homeSeo.linkSetup') },
	{ href: links.updates, label: t('homeSeo.linkLiveStatus') },
];

---

<section class="home-seo">
	<div class="shell">
		<section class="home-seo__pillar" aria-labelledby="home-pillar-title">
			<h3 id="home-pillar-title">{t('pillar.exploreCheats')}</h3>
			<p class="home-seo__pillar-lede">{t('pillar.exploreCheatsLede')}</p>
			<ul class="home-seo__pillar-grid">
				{pillarLinks.map((link) => (
					<li>
						<a href={link.href}>
							<span>{link.label}</span>
							<span class="home-seo__arrow" aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		{
			faqs.length > 0 && (
				<section class="home-seo__faq" id="faq" aria-labelledby="home-faq-title">
					<header class="home-seo__faq-head">
						<div>
							<p class="home-seo__eyebrow">{t('homeSeo.faqEyebrow')}</p>
							<h3 id="home-faq-title">{t('homeSeo.faqTitle')}</h3>
							<p class="home-seo__faq-lede">{t('homeSeo.faqLede')}</p>
							{locale !== 'en' && (
								<p class="home-seo__faq-note">{t('common.faqAnswersEnglish')}</p>
							)}
						</div>
						<a class="home-seo__faq-all" href={links.faq}>{t('homeSeo.allAnswers')}</a>
					</header>
					<div class="home-seo__faq-list">
						{faqs.map((item) => (
							<details class="home-seo__faq-item" id={item.slug}>
								<summary>
									<span>{item.question}</span>
									<span class="home-seo__chev" aria-hidden="true" />
								</summary>
								<div class="home-seo__faq-body">
									<p>{item.answer}</p>
								</div>
							</details>
						))}
					</div>
					{indexedFaqLinks.length > 0 && (
						<nav class="home-seo__faq-more" aria-label={t('homeSeo.indexedFaqTitle')}>
							<h4>{t('homeSeo.indexedFaqTitle')}</h4>
							<ul>
								{indexedFaqLinks.map((item) => (
									<li>
										<a href={item.href}>{item.question}</a>
									</li>
								))}
							</ul>
						</nav>
					)}
				</section>
			)
		}
	</div>
</section>

<style>
	.home-seo {
		padding-block: clamp(2.75rem, 5vw, 4rem);
	}

	.home-seo__eyebrow {
		margin: 0 0 0.25rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home-seo__arrow {
		color: var(--magenta-soft);
		font-size: 0.9rem;
		opacity: 0.85;
	}

	.home-seo__pillar h3 {
		margin: 0 0 0.45rem;
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 2vw, 1.45rem);
		font-weight: 800;
		color: #fff;
	}

	.home-seo__pillar-lede {
		margin: 0 0 1rem;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--ink-muted);
		max-width: 40rem;
	}

	.home-seo__pillar-grid {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.5rem;
	}

	.home-seo__pillar-grid a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.7rem 0.85rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm, 0.5rem);
		background: var(--bg-elevated);
		color: var(--ink);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		transition: border-color 0.2s ease, color 0.2s ease;
	}

	.home-seo__pillar-grid a:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		color: var(--magenta-soft);
	}

	.home-seo__faq {
		margin-top: clamp(2rem, 4vw, 2.75rem);
		padding-top: clamp(1.75rem, 3vw, 2.25rem);
		border-top: 1px solid var(--line-soft);
	}

	.home-seo__faq-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
		flex-wrap: wrap;
	}

	.home-seo__faq-head h3 {
		margin: 0 0 0.4rem;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2.2vw, 1.55rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: #fff;
	}

	.home-seo__faq-lede {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--ink-muted);
		max-width: 36rem;
	}

	.home-seo__faq-note {
		margin: 0.5rem 0 0;
		font-size: 0.8125rem;
		color: var(--ink-faint);
	}

	.home-seo__faq-all {
		flex-shrink: 0;
		padding: 0.5rem 1rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--magenta-soft);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.home-seo__faq-all:hover {
		border-color: color-mix(in srgb, var(--magenta) 45%, var(--line));
		background: color-mix(in srgb, var(--magenta) 10%, transparent);
		color: #fff;
	}

	.home-seo__faq-list {
		display: grid;
		gap: 0.5rem;
	}

	.home-seo__faq-item {
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-elevated);
		overflow: hidden;
	}

	.home-seo__faq-item summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.95rem 1.1rem;
		font-size: 0.9375rem;
		font-weight: 600;
		color: #ffffff;
		cursor: pointer;
		list-style: none;
	}

	.home-seo__faq-item summary::-webkit-details-marker {
		display: none;
	}

	.home-seo__chev {
		flex-shrink: 0;
		width: 0.5rem;
		height: 0.5rem;
		border-right: 2px solid var(--magenta-soft);
		border-bottom: 2px solid var(--magenta-soft);
		transform: rotate(45deg);
		transition: transform 0.2s ease;
	}

	.home-seo__faq-item[open] .home-seo__chev {
		transform: rotate(-135deg);
	}

	.home-seo__faq-body {
		padding: 0 1.1rem 1rem;
		border-top: 1px solid var(--line-soft);
	}

	.home-seo__faq-body p {
		margin: 0.85rem 0 0.65rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: #ffffff;
	}

	.home-seo__faq-link {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--magenta-soft);
		text-decoration: none;
	}

	.home-seo__faq-link:hover {
		color: #fff;
	}

	.home-seo__faq-more {
		margin-top: 1.25rem;
		padding-top: 1rem;
		border-top: 1px dashed var(--line-soft);
	}

	.home-seo__faq-more h4 {
		margin: 0 0 0.65rem;
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--ink-muted);
	}

	.home-seo__faq-more ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.4rem;
	}

	.home-seo__faq-more a {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--magenta-soft);
		text-decoration: none;
	}

	.home-seo__faq-more a:hover {
		color: #fff;
		text-decoration: underline;
	}

	@media (max-width: 900px) {
		.home-seo__pillar-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.home-seo__faq-head {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
