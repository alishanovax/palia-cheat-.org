{
	"name": "palia-cheats",
	"type": "module",
	"version": "1.0.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"sync:brand": "node scripts/sync-brand.mjs && node scripts/sync-cannibal-redirects.mjs && node scripts/sync-path-redirects.mjs",
		"prebuild": "node scripts/sync-brand.mjs && node scripts/sync-cannibal-redirects.mjs && node scripts/sync-path-redirects.mjs && node scripts/validate-cannibal-routes.mjs",
		"build": "astro build",
		"postbuild": "node scripts/strip-brand-studio.mjs",
		"build:validate": "npm run sync:brand && astro build && node scripts/strip-brand-studio.mjs && npm run validate:sitemaps",
		"dev:stop": "astro dev stop",
		"dev:status": "astro dev status",
		"dev:logs": "astro dev logs",
		"optimize:images": "node scripts/optimize-responsive-images.mjs",
		"fetch:images": "node scripts/fetch-palia-images.mjs",
		"import:gameplay": "node scripts/import-palia-gameplay.mjs && node scripts/ensure-image-variants.mjs",
		"ensure:variants": "node scripts/ensure-image-variants.mjs",
		"generate:forum": "node scripts/generate-forum-posts.mjs",
		"generate:brand": "node scripts/generate-brand-assets.mjs",
		"preview": "astro preview",
		"validate:sitemaps": "node scripts/validate-cannibal-routes.mjs && node scripts/validate-sitemaps.mjs && node scripts/audit-sitemap-deep.mjs",
		"test:rich-results": "node scripts/test-rich-results.mjs",
		"generate:i18n": "node scripts/generate-i18n-content.mjs",
		"generate:translations": "node scripts/generate-translation-json.mjs",
		"deploy": "npm run build && wrangler deploy",
		"pages:deploy": "wrangler pages deploy dist --project-name=paliacheats",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/react": "^6.0.2",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/syne": "^5.2.7",
		"@tailwindcss/vite": "^4.3.2",
		"astro": "^7.0.9",
		"i18next": "^26.3.6",
		"i18next-browser-languagedetector": "^8.2.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-i18next": "^17.0.11",
		"tailwindcss": "^4.3.2"
	},
	"devDependencies": {
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"sharp": "^0.35.3",
		"terser": "^5.49.0",
		"wrangler": "^4.30.0"
	}
}
